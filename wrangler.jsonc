{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fire-growth-tracker",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fire-growth-tracker-db",
      "database_id": "a43688ed-f459-4a6d-a041-cde30452c403"
    }
  ],
  "triggers": {
    "crons": ["0 13 * * *"]
  }
}
